APP_ENV=local
SERVER_PORT=8092

MYSQL_DSN=DB_USER:DB_PASSWORD@tcp(127.0.0.1:3306)/element?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_DB=1
REDIS_PASSWORD=

JWT_SECRET=CHANGE_ME_TO_A_SECURE_SECRET
JWT_EXPIRE_MINUTES=30

CAPTCHA_ENABLED=true
UPLOAD_PATH=./tmp/uploadPath

# Phase-one competency Word template rendering (Microsoft Graph)
PHASE1_WORD_REPORT_ENABLED=false
PHASE1_WORD_REPORT_TEMPLATE_PATH=./configs/export-templates/competency-phase1-report.docx
PHASE1_WORD_REPORT_FALLBACK_CHROMIUM=true
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_DRIVE_ID=
MSGRAPH_REPORT_FOLDER=talent-assessment-reports
MSGRAPH_TIMEOUT_SECONDS=90
