{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: Build",
      "type": "shell",
      "command": "cd 'Go-based Refactored System'; go build -o bin/server.exe ./cmd/server",
      "group": "build",
      "problemMatcher": ["$go"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Go: Test All",
      "type": "shell",
      "command": "cd 'Go-based Refactored System'; go test ./... -v -count=1",
      "group": "test",
      "problemMatcher": ["$go"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Go: Test Coverage",
      "type": "shell",
      "command": "cd 'Go-based Refactored System'; go test ./... -coverprofile=coverage.out; go tool cover -html=coverage.out -o coverage.html",
      "group": "test",
      "problemMatcher": ["$go"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Go: Lint",
      "type": "shell",
      "command": "cd 'Go-based Refactored System'; golangci-lint run ./...",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Test: Competency Participant E2E",
      "type": "shell",
      "command": "node scripts/test/competency-mobile-ui-test.js; node scripts/test/competency-answer-flow-e2e.js; node scripts/test/competency-submit-guard-e2e.js",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Test: Phase-1 Template Contracts",
      "type": "shell",
      "command": "cd 'Go-based Refactored System'; go test ./internal/handler -run 'TestBugFB1(54|55|60|61|62)|TestPhase1CustomerWordTemplateHasCompleteStableContract' -count=1",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "UX: Scan Page Operations",
      "type": "shell",
      "command": "node scripts/test/page-operation-scanner.js ${input:pagePath}",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "UX: Run Chain + Expert Review",
      "type": "shell",
      "command": "node scripts/test/ux-chain-runner.js ${input:chainId}",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Frontend: Dev Server",
      "type": "shell",
      "command": "cd 'Go-based Refactored System/ruoyi-ui'; npm run dev",
      "isBackground": true,
      "group": "none",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend: Vitest (run once)",
      "type": "shell",
      "command": "cd 'Go-based Refactored System/ruoyi-ui'; npm test",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Frontend: Vitest (watch)",
      "type": "shell",
      "command": "cd 'Go-based Refactored System/ruoyi-ui'; npm run test:watch",
      "isBackground": true,
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend: Vitest Coverage",
      "type": "shell",
      "command": "cd 'Go-based Refactored System/ruoyi-ui'; npm run test:coverage",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ],
  "inputs": [
    {
      "id": "pagePath",
      "type": "promptString",
      "description": "页面路径（例如 /#/exam/exam）",
      "default": "/#/index"
    },
    {
      "id": "chainId",
      "type": "pickString",
      "description": "选择业务链",
      "options": ["A", "B", "D", "F"],
      "default": "A"
    }
  ]
}
